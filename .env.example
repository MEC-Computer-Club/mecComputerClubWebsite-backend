# Server Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database (MongoDB Atlas or Local MongoDB)
MONGO_URI=mongodb://localhost:27017/mec_computer_club

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Service (SMTP)
# 1. System / Transactional Mailer (Account verification, password reset, 2FA alerts)
SMTP_HOST=server25.flexohost.com
SMTP_PORT=587
SMTP_USER=no-reply@meccomputerclub.org
SMTP_PASS=your_noreply_mailbox_password
EMAIL_FROM_NOREPLY="MEC Computer Club <no-reply@meccomputerclub.org>"

# 2. Official Communications Mailer (Contact message replies, event broadcasts, approvals)
# If omitted, system falls back to SMTP_USER with official replyTo
SMTP_OFFICIAL_HOST=server25.flexohost.com
SMTP_OFFICIAL_PORT=587
SMTP_OFFICIAL_USER=official@meccomputerclub.org
SMTP_OFFICIAL_PASS=your_official_mailbox_password
EMAIL_FROM_OFFICIAL="MEC Computer Club <official@meccomputerclub.org>"
EMAIL_REPLY_TO_OFFICIAL=official@meccomputerclub.org

# Fallback default sender
EMAIL_FROM="MEC Computer Club <no-reply@meccomputerclub.org>"
